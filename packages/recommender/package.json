{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@karakeep/recommender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "@karakeep/shared": "workspace:^0.1.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@karakeep/tsconfig": "workspace:^0.1.0",
